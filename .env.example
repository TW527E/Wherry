# 複製為 .env 後再填入自己的設定；不要覆蓋既有設定，也不要提交已填好的檔案。
# 完整用途、預設值、範圍與憑證取得步驟：docs/configuration.md
# 本範例預設不啟用任何帳戶。preview 不發布，但啟用來源後仍可能連網讀取。
# 布林值只使用小寫 true / false；空字串不代表「使用布林預設值」。
# 相對路徑以啟動程式的工作目錄為準。正式／試跑環境請使用不同 DATA_DIR。

# --- 執行模式與目的地 ---------------------------------------------------------
# preview（預設）：模擬發布並寫入本機狀態，不發平台貼文或 Telegram 訊息。
# live：真的發布到選定下游；X 在任何模式下都只讀，發文永遠由你手動完成。
APP_MODE=preview

# 以逗號分隔 bluesky,sharkey,telegram；預設空白，不建立對外發布目的地。
# Bluesky／Sharkey 目的地必須同時啟用對應來源，以便防回音。
# Telegram 對外發文必須含 telegram；私聊提醒／錯誤告警不靠此清單啟用。
# 範例（確認帳戶、憑證與頻道後才填）：bluesky,sharkey,telegram
DESTINATIONS=

# SQLite、媒體與預設 X session/profile 的根目錄；預設 ./data。
# 由你指定可寫的私密目錄；同一資料目錄僅供一個執行中的程式使用。
DATA_DIR=./data

# --- Web 介面 ----------------------------------------------------------------
# 預設僅在 IPv4 loopback 提供服務；可用 ::1。
# 其他值（連 localhost 也包含）必須搭配至少 32 字元 WEB_TOKEN。
# 不建議直接對外開放：WEB_TOKEN 保護寫入，不是所有 GET 頁面的登入機制。
HOST=127.0.0.1
# TCP 連接埠；預設 3000，整數 1–65535。
PORT=3000
# 預設空白；由密碼管理器／安全亂數自行產生，建議 32 隨機 bytes 以上。
# 設定後所有寫入請求須帶 Authorization: Bearer；不要在命令列貼出 token。
WEB_TOKEN=

# --- X：僅讀取自己的個人頁 ----------------------------------------------------
# 預設 false；啟用前請閱讀 README 的 X 自動化政策風險。
X_ENABLED=false
# 自己的帳號，不含 @；啟用讀取時為 1–15 個英數字／底線。
# 從自己的 X 個人頁取得；手動鏡像連結登記也要填自己的帳號。
X_HANDLE=

# 預設 auto；可選 auto / chrome / chrome-beta / msedge / msedge-beta / chromium / path。
# auto 依序尋找系統 Chrome → Edge → Chromium，再交由 Playwright 尋找 Chrome。
# beta 選項也可能先找到 stable；精確指定版本時請用 path。
X_BROWSER=auto
# 預設空白；填已安裝瀏覽器的執行檔路徑，可覆蓋任何 X_BROWSER 選項。
# X_BROWSER=path 時必填；含空白的路徑請加雙引號。
CHROMIUM_PATH=
# 留空時使用 DATA_DIR/x-profile；這是專用瀏覽器 profile，不是日常瀏覽器資料夾。
# 由 login/import-session 建立。內含帳號登入資料，限制存取、勿進版控。
X_PROFILE_DIR=
# 讀取時是否使用無頭模式；預設 true。login 仍固定開啟可見視窗供你登入。
X_HEADLESS=true
# 每次讀取最多捲動／解析的輪數；預設 4，整數 1–10，不保證讀到全部串文。
X_MAX_PAGES=4
# 留空時使用 DATA_DIR/x-session.json；export-session 寫入，import-session 讀取。
# 自訂位置時先建立私密父目錄；此檔等同登入憑證，不可上傳到公開位置。
X_SESSION_FILE=
# Chromium sandbox：不設定時，Linux root 預設 false；其他環境預設 true。
# 若要強制覆寫才取消下一行註解；不要寫空值或 auto，它們都會被當成 false。
# 正式部署請用非 root 專用使用者，勿把關閉 sandbox 當成一般排錯步驟。
# X_SANDBOX=true

# --- Bluesky：官方 API --------------------------------------------------------
# 預設 false；需要啟用來源觀察才能把 bluesky 加入 DESTINATIONS。
BLUESKY_ENABLED=false
# 預設空白；完整 handle（不含 @）、DID 或登入 email；建議使用 handle。
# 從自己的 Bluesky 個人頁／帳號設定取得，必須與下方 app password 同帳號。
BLUESKY_IDENTIFIER=
# 預設空白；在官方 App 的設定 → App passwords 建立專用應用程式密碼。
# 不要填主密碼；此工具不需私訊存取權。完整官方入口見設定文件。
BLUESKY_APP_PASSWORD=
# 登入 email 的 bootstrap 服務；預設 https://bsky.social。
# 自架 PDS 使用其管理員公布的 HTTPS 服務位址；實際 PDS 仍由 DID 探索。
BLUESKY_SERVICE_URL=https://bsky.social

# --- Sharkey：自己的實例與帳戶 ------------------------------------------------
# 預設 false；需要啟用來源觀察才能把 sharkey 加入 DESTINATIONS。
SHARKEY_ENABLED=false
# 程式預設 https://dvd.chat；不是固定目的地，可覆寫成你自己實例的 HTTPS 原點。
# 不要加 /api 或憑證；不要填內網位址。
SHARKEY_URL=https://dvd.chat
# 預設空白；在自己的實例設定 → API／存取權杖建立。
# 最小發文權限 write:notes、write:drive；建議同時填自己的 SHARKEY_USERNAME。
# USER_ID 和 USERNAME 都未填時，以 /api/i 探索帳號，另需 read:account。
SHARKEY_TOKEN=
# 預設空白；選填自己的本機 user ID，可從實例官方 users/show 回應 id 取得。
# 若與 USERNAME 都填，兩者必須指向同一帳戶；不要填遠端聯邦帳戶 ID。
SHARKEY_USER_ID=
# 預設空白；建議填自己的本機帳號名，不含 @ 或 @實例網域。
# 可從個人頁取得；有 USER_ID 時優先用 USER_ID 查詢，仍核對此名稱。
SHARKEY_USERNAME=
# 每則從 X 同步過來的 Sharkey 貼文底部署名（MFM/Markdown）；{url} 會換成該貼文的 X 原文連結。
# 語義用 `??`：整行維持註解＝沿用內建預設署名；設成空字串（SHARKEY_SIGNATURE=）＝完全不加署名。
# 兩者不同：註解掉不是空字串。內容含 MFM 標記時整段照填，不要另外加引號。
# SHARKEY_SIGNATURE=

# --- Telegram：私聊、維運通知、對外頻道 ---------------------------------------
# 預設 false；啟用需 BOT_TOKEN。只有 live 會送出 Telegram 訊息。
TELEGRAM_ENABLED=false
# 預設空白；透過 Telegram 官方 @BotFather 的 /newbot 取得專用 bot token。
# 不要把含 token 的 Bot API URL 貼進命令列、瀏覽器網址列或問題回報。
TELEGRAM_BOT_TOKEN=
# 預設空白；唯一能操作 bot 的本人 Telegram 數字 user ID，不是 @username。
# 用官方 getUpdates 回應的 message.from.id 確認；安全取得方法見設定文件。
TELEGRAM_OWNER_ID=
# 留空時回退到 TELEGRAM_OWNER_ID；建議核對 getUpdates 的 message.chat.id。
# 僅限與 bot 的私人聊天；先在 Telegram 私聊 bot 並送出 /start。
TELEGRAM_PRIVATE_CHAT_ID=
# 預設空白；維運告警的數字 chat ID。未填時，錯誤告警回退到私人聊天。
# 頻道可從 channel_post.chat.id 取得（常為 -100 開頭）；bot 需發文權限。
TELEGRAM_OPS_CHAT_ID=
# 預設空白；對外發布頻道的數字 chat ID，bot 需有頻道發文權限。
# 只有 live + ENABLED=true + DESTINATIONS 含 telegram 才對外發文。
TELEGRAM_PUBLIC_CHAT_ID=
# 預設 false；live 下設 true 才每 5 秒接收指令、按鈕、回覆與 /session 上傳。
# 與錯誤告警開關獨立：false 仍可在 live 發送私聊提醒與 ops 告警。
# preview 不輪詢、不登記指令選單，也不發 Telegram 訊息。
TELEGRAM_POLL_COMMANDS=false

# --- 時間與重試限制：均由使用者依運作情況調整 ----------------------------------
# 來源收集與 worker 的週期（秒）；預設 120，整數 30–86400，固定間隔。
POLL_SECONDS=120
# X root 發布時間起算的固定自串文窗口（秒）；預設 600，整數 30–3600。
THREAD_WINDOW_SECONDS=600
# 窗口結束／root 首次被讀到（較晚者）後的額外等待（秒）；預設 180，整數 30–1800。
THREAD_SETTLE_SECONDS=180
# 封存時允許來源最後成功掃描距今最多幾秒；預設 300，整數 30–3600。
# 宜大於 POLL_SECONDS 並預留收集時間；過小會持續等待新鮮的來源資料。
SOURCE_FRESHNESS_SECONDS=300
# 已確認可重試的暫時錯誤之自動嘗試上限（含首次）；預設 5，整數 1–20。
# unknown 送出結果一律不自動重試，/retry 也不能繞過對帳。
MAX_ATTEMPTS=5
# 單一媒體輸入／下載的位元組上限；預設 20000000，整數 1000–100000000。
# 不是圖片輸出大小；圖片輸出固定最多 2000000 bytes，最多四張靜態圖。
MAX_DOWNLOAD_BYTES=20000000

# --- 影片同步（選用） ---------------------------------------------------------
# 預設 false；設 true 時，帶單一影片的貼文會轉碼成安全的 MP4（H.264/AAC、≤140 秒）
# 並發布到 Bluesky／Sharkey。需要系統已安裝 ffmpeg／ffprobe。
# 注意：X 的影片以 HLS 串流（blob: 網址）提供，除非收集器能擷取到可直接下載的
# 播放清單網址，否則帶影片的 X 貼文會被保留並附上原因，不會硬發成純文字。
VIDEO_ENABLED=false
# 模組使用的程式名或執行檔路徑；預設 ffmpeg / ffprobe（由 PATH 搜尋）。
# 一般文字／靜態圖同步不需要；只在 VIDEO_ENABLED=true 時才會被呼叫。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
