# Copy to .env and fill in. Never commit the filled file.

# preview  = run the whole pipeline against stub publishers (no remote writes)
# live     = actually publish to Bluesky / dvd.chat / Telegram (X stays manual)
APP_MODE=preview

# Comma separated destinations. A destination must also have its source enabled,
# because the tool can only rule out a manual mirror if it observes that account.
# DESTINATIONS=bluesky,sharkey,telegram
DESTINATIONS=

DATA_DIR=./data

# When binding outside loopback, WEB_TOKEN must be at least 32 characters and is
# required as "Authorization: Bearer <token>" for every write request.
HOST=127.0.0.1
PORT=3000
WEB_TOKEN=

# --- X (read only) -----------------------------------------------------------
# The collector can only read your own profile. It never logs in for you and it
# can never post. Read the risk note in README.md before enabling this.
X_ENABLED=false
X_HANDLE=
# Which browser the X collector launches for reading:
#   auto     detect system Chrome, then Edge, then Chromium; otherwise let
#            Playwright find Chrome (default)
#   chrome   system Google Chrome (stable)
#   msedge   system Microsoft Edge
#   chromium distribution Chromium package
#   path     use exactly CHROMIUM_PATH
X_BROWSER=auto
# Only needed when X_BROWSER=path (or to force a specific binary).
CHROMIUM_PATH=
# Optional: an existing persistent browser profile directory created by you
# (log in once with that browser, then keep this directory private).
X_PROFILE_DIR=./data/x-profile
X_HEADLESS=true
X_MAX_PAGES=4
# Where `export-session` writes and `import-session` reads the portable login file.
# This file holds your X account session — keep it secret, never commit it.
X_SESSION_FILE=./data/x-session.json
# Chromium sandbox. Auto: off when running as root on Linux (sandbox can't start there),
# on otherwise. Set true/false to force it. Leave unset unless the browser fails to launch.
# X_SANDBOX=false

# --- Bluesky (official API) --------------------------------------------------
BLUESKY_ENABLED=false
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# --- Sharkey / dvd.chat (HTTP API) -------------------------------------------
# Create an app token with write:drive and write:notes only.
SHARKEY_ENABLED=false
SHARKEY_URL=https://dvd.chat
SHARKEY_TOKEN=
SHARKEY_USER_ID=
SHARKEY_USERNAME=

# --- Telegram ----------------------------------------------------------------
# Use numeric IDs (not @usernames) for the owner and every chat.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_PRIVATE_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_PUBLIC_CHAT_ID=
# Set true to let the bot read your private-chat commands (/help /status /pending …)
# and register the "/" command menu. Leave false and the bot only sends notifications.
TELEGRAM_POLL_COMMANDS=false

# --- Timing / limits ---------------------------------------------------------
POLL_SECONDS=120
THREAD_WINDOW_SECONDS=600
THREAD_SETTLE_SECONDS=180
SOURCE_FRESHNESS_SECONDS=300
MAX_ATTEMPTS=5
MAX_DOWNLOAD_BYTES=20000000
